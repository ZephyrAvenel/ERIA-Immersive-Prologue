{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zephyravenel.github.io/ERIA-Immersive-Prologue/schemas/workshop-pack.schema.json",
  "title": "INE Workshop Pack",
  "description": "Foundation contract for a self-contained augmented workshop.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "id",
    "slug",
    "title",
    "subtitle",
    "language",
    "startPage",
    "movements",
    "pages"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "ine-workshop-pack" },
    "version": { "const": "1.0" },
    "id": { "$ref": "#/$defs/kebabId" },
    "slug": { "$ref": "#/$defs/kebabId" },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 2 },
    "startPage": { "type": "string", "minLength": 1 },
    "movements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/movement" }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "kebabId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "movement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/kebabId" },
        "order": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "movementId", "order", "title", "blocks"],
      "properties": {
        "id": { "$ref": "#/$defs/kebabId" },
        "movementId": { "$ref": "#/$defs/kebabId" },
        "order": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/block" }
        }
      }
    },
    "blockBase": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/kebabId" },
        "type": {
          "type": "string",
          "enum": ["text", "textarea", "choice", "reveal", "promptCopy", "recall"]
        }
      }
    },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/textBlock" },
        { "$ref": "#/$defs/textareaBlock" },
        { "$ref": "#/$defs/choiceBlock" },
        { "$ref": "#/$defs/revealBlock" },
        { "$ref": "#/$defs/promptCopyBlock" },
        { "$ref": "#/$defs/recallBlock" }
      ]
    },
    "textBlock": {
      "allOf": [{ "$ref": "#/$defs/blockBase" }],
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/kebabId" },
        "type": { "const": "text" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "textareaBlock": {
      "allOf": [{ "$ref": "#/$defs/blockBase" }],
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/kebabId" },
        "type": { "const": "textarea" },
        "label": { "type": "string", "minLength": 1 },
        "placeholder": { "type": "string" },
        "required": { "type": "boolean" }
      }
    },
    "choiceBlock": {
      "allOf": [{ "$ref": "#/$defs/blockBase" }],
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label", "options"],
      "properties": {
        "id": { "$ref": "#/$defs/kebabId" },
        "type": { "const": "choice" },
        "label": { "type": "string", "minLength": 1 },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/choiceOption" }
        },
        "allowMultiple": { "type": "boolean" }
      }
    },
    "choiceOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/kebabId" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "revealBlock": {
      "allOf": [{ "$ref": "#/$defs/blockBase" }],
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/kebabId" },
        "type": { "const": "reveal" },
        "label": { "type": "string", "minLength": 1 },
        "content": { "type": "string", "minLength": 1 }
      }
    },
    "promptCopyBlock": {
      "allOf": [{ "$ref": "#/$defs/blockBase" }],
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/kebabId" },
        "type": { "const": "promptCopy" },
        "label": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "recallBlock": {
      "allOf": [{ "$ref": "#/$defs/blockBase" }],
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "sourceBlockId"],
      "properties": {
        "id": { "$ref": "#/$defs/kebabId" },
        "type": { "const": "recall" },
        "sourceBlockId": { "$ref": "#/$defs/kebabId" },
        "label": { "type": "string" },
        "emptyText": { "type": "string" }
      }
    }
  }
}
