{
  "$schema": "../../schemas/workshop-pack.schema.json",
  "format": "ine-workshop-pack",
  "version": "1.0",
  "id": "workshop-demo",
  "slug": "workshop-demo",
  "title": "Atelier augmenté — démonstrateur technique",
  "subtitle": "Runtime minimal des Ateliers augmentés",
  "language": "fr",
  "startPage": "page-01",
  "movements": [
    {
      "id": "entrer",
      "order": 1,
      "title": "ENTRER",
      "description": "Vérifier l'entrée dans un atelier."
    },
    {
      "id": "explorer",
      "order": 2,
      "title": "EXPLORER",
      "description": "Vérifier le changement de mouvement."
    }
  ],
  "pages": [
    {
      "id": "page-01",
      "movementId": "entrer",
      "order": 1,
      "title": "Entrer dans l'atelier",
      "blocks": [
        {
          "id": "intro",
          "type": "text",
          "text": "Cette page valide l'entrée dans un Workshop Pack minimal."
        }
      ]
    },
    {
      "id": "page-02",
      "movementId": "entrer",
      "order": 2,
      "title": "Écrire quelques mots",
      "blocks": [
        {
          "id": "writing-intro",
          "type": "text",
          "text": "Cette page vérifie qu'une réponse locale reste disponible pendant la traversée courante."
        },
        {
          "id": "technical-note",
          "type": "textarea",
          "label": "Note technique temporaire",
          "placeholder": "Écrivez quelques mots pour tester la mémoire en cours de traversée."
        }
      ]
    },
    {
      "id": "page-03",
      "movementId": "explorer",
      "order": 3,
      "title": "Choisir une piste",
      "blocks": [
        {
          "id": "choice-intro",
          "type": "text",
          "text": "Cette page appartient au deuxième mouvement grâce à sa donnée movementId et vérifie une sélection unique."
        },
        {
          "id": "technical-choice",
          "type": "choice",
          "label": "Quelle orientation technique souhaitez-vous sélectionner ?",
          "options": [
            {
              "id": "lire",
              "label": "Lire"
            },
            {
              "id": "ecrire",
              "label": "Écrire"
            },
            {
              "id": "reveler",
              "label": "Révéler"
            }
          ]
        }
      ]
    },
    {
      "id": "page-04",
      "movementId": "explorer",
      "order": 4,
      "title": "Révéler une information",
      "blocks": [
        {
          "id": "reveal-intro",
          "type": "text",
          "text": "Cette dernière page vérifie l'ouverture contrôlée d'un contenu complémentaire."
        },
        {
          "id": "technical-reveal",
          "type": "reveal",
          "label": "Révéler le contenu technique",
          "content": "Le contenu révélé apparaît seulement après activation et reste ouvert pendant cette traversée."
        }
      ]
    }
  ]
}
