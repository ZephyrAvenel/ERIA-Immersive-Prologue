{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zephyravenel.github.io/ERIA-Immersive-Prologue/schemas/narrative-pack.schema.json",
  "title": "INE Narrative Pack",
  "description": "Foundation contract for a self-contained narrative work.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "id", "title", "language", "startScene", "scenes"],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "ine-narrative-pack" },
    "version": { "const": "1.0" },
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "coverImage": { "type": "string", "minLength": 1 },
    "coverImageAlt": { "type": "string" },
    "layout": {
      "type": "string",
      "enum": ["image-then-text"]
    },
    "language": { "type": "string", "minLength": 2 },
    "startScene": { "type": "string", "minLength": 1 },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultTransition": { "$ref": "#/$defs/transition" },
        "intro": { "$ref": "#/$defs/intro" }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scene" }
    }
  },
  "$defs": {
    "intro": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lines", "actionLabel"],
      "properties": {
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "title": { "type": "string", "minLength": 1 },
        "actionLabel": { "type": "string", "minLength": 1 }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "text"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "image": { "type": "string", "minLength": 1 },
        "imageAlt": { "type": "string" },
        "imageDisplayMode": {
          "type": "string",
          "enum": ["contain", "cover", "fill", "immersive"],
          "default": "contain"
        },
        "links": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sceneLink" }
        },
        "transition": { "$ref": "#/$defs/transition" }
      }
    },
    "sceneLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "href"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "href": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["none", "fade", "crossfade", "slide"]
        },
        "durationMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 3000
        },
        "easing": {
          "type": "string",
          "enum": ["linear", "ease", "ease-in", "ease-out", "ease-in-out"],
          "default": "ease-in-out"
        }
      }
    }
  }
}
