{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zephyravenel.github.io/ERIA-Immersive-Prologue/schemas/editorial-metadata.schema.json",
  "title": "INE Editorial Metadata",
  "description": "Optional author-universe metadata shared by Zéphyr Avenel immersive works.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "longDescription": {
          "type": "string",
          "minLength": 1
        },
        "shareImage": {
          "type": "string",
          "minLength": 1
        },
        "shareImageAlt": {
          "type": "string"
        },
        "estimatedDurationMinutes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "createdAt": {
          "$ref": "#/$defs/date"
        },
        "publishedAt": {
          "$ref": "#/$defs/date"
        },
        "updatedAt": {
          "$ref": "#/$defs/date"
        },
        "copyright": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keywords": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "seoDescription": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/connection"
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "title"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "book",
            "article",
            "immersive-work",
            "eria",
            "author-site"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "targetWorkId": {
          "type": "string",
          "minLength": 1
        },
        "relationship": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "url"
          ]
        },
        {
          "required": [
            "targetWorkId"
          ]
        }
      ]
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "label",
        "url"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "illustration",
            "audio",
            "video",
            "document",
            "download"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
