{
  "name": "immersive-narrative-engine",
  "version": "1.0.0",
  "private": true,
  "description": "A work-independent runtime for standards-compliant Narrative Packs.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "npm run test:ci",
    "test:prepare": "tsc -p tsconfig.test.json",
    "test:unit": "npm run test:prepare && node --test tests/run-unit.mjs",
    "test:integration": "npm run test:prepare && node --test tests/run-integration.mjs",
    "test:e2e": "node --test tests/e2e/player.test.mjs",
    "test:coverage": "npm run test:prepare && node --test --experimental-test-coverage --test-coverage-include=.test-build/packages/core/src/index.js --test-coverage-include=.test-build/packages/renderer/src/index.js --test-coverage-include=.test-build/packages/validators/src/index.js --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=70 tests/run-unit-integration.mjs",
    "test:ci": "npm run typecheck && npm run test:unit && npm run test:integration && npm run test:coverage && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  }
}
